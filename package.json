{
  "name": "shouchuan-shop",
  "version": "0.1.0",
  "private": true,
  "description": "手串電商 — 前台購物車 + 後台成本與採購管理",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply shouchuan-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply shouchuan-db --remote",
    "db:seed:local": "wrangler d1 execute shouchuan-db --local --file=db/seed/seed.sql",
    "db:backup": "wrangler d1 export shouchuan-db --remote --output=backups/d1-backup.sql",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "drizzle-orm": "0.45.2",
    "zod": "4.6.2",
    "exceljs": "4.4.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "wrangler": "4.131.0",
    "drizzle-kit": "0.31.10",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "typescript": "5.9.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}
